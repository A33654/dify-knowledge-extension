@@ 两个新 Resource（建议放在 DocumentAddByFileApi 之后）
+@service_api_ns.route("/datasets/<uuid:dataset_id>/documents/async-tasks/<uuid:task_id>")
+class DocumentAsyncTaskStatusApi(DatasetApiResource):
+    @service_api_ns.doc(
+        summary="Get document async task",
+        description=(
+            "Returns the status, progress and error information of an asynchronous document upload task. "
+            "Poll this endpoint with the `task_id` returned by the create-by-file endpoint. "
+            "`next_attempt_at` is set only while an automatic retry is still scheduled; "
+            "`dead_letter` is terminal and requires a manual retry."
+        ),
+        tags=["Documents"],
+    )
+    @service_api_ns.doc(
+        responses={
+            200: "Task retrieved successfully",
+            401: "Unauthorized - invalid API token",
+            404: "Dataset or task not found",
+        }
+    )
+    @service_api_ns.response(
+        200, "Task retrieved successfully", service_api_ns.models[DocumentAsyncTaskStatusResponse.__name__]
+    )
+    @with_session(write=False)
+    def get(self, session: Session, tenant_id, dataset_id: UUID, task_id: UUID):
+        tenant_id_str = str(tenant_id)
+        dataset_id_str = str(dataset_id)
+        dataset = session.scalar(
+            select(Dataset).where(Dataset.tenant_id == tenant_id_str, Dataset.id == dataset_id_str).limit(1)
+        )
+        if not dataset:
+            raise NotFound("Dataset not found.")
+
+        task = _load_owned_async_task(
+            session, tenant_id=tenant_id_str, dataset_id=dataset_id_str, task_id=str(task_id)
+        )
+        # Deliberately 404 rather than 403 so the endpoint cannot be used to
+        # probe whether a task id exists in another tenant.
+        if task is None:
+            raise NotFound("Task not found.")
+        return _async_task_status_response(session, task), 200
+
+
+@service_api_ns.route("/datasets/<uuid:dataset_id>/documents/async-tasks/<uuid:task_id>/retry")
+class DocumentAsyncTaskRetryApi(DatasetApiResource):
+    @service_api_ns.doc(
+        summary="Retry a dead-letter document async task",
+        description=(
+            "Re-queues an asynchronous document upload task that reached `dead_letter`. "
+            "The same `task_id` is reused so an in-flight polling client keeps working. "
+            "Returns 202 once the task is published; the row is reset to `pending` and "
+            "`attempt_count` restarts from zero."
+        ),
+        tags=["Documents"],
+    )
+    @service_api_ns.doc(
+        responses={
+            202: "Task re-queued successfully",
+            401: "Unauthorized - invalid API token",
+            404: "Dataset or task not found",
+            409: "Task is not in dead_letter state",
+            503: "Failed to re-dispatch, the task stays in dead_letter",
+        }
+    )
+    @service_api_ns.response(
+        202, "Task re-queued successfully", service_api_ns.models[DocumentAsyncTaskStatusResponse.__name__]
+    )
+    @error_responses(DocumentAsyncTaskNotRetryableError, DocumentAsyncTaskRetryDispatchError)
+    @with_session(write=True)
+    def post(self, session: Session, tenant_id, dataset_id: UUID, task_id: UUID):
+        tenant_id_str = str(tenant_id)
+        dataset_id_str = str(dataset_id)
+        dataset = session.scalar(
+            select(Dataset).where(Dataset.tenant_id == tenant_id_str, Dataset.id == dataset_id_str).limit(1)
+        )
+        if not dataset:
+            raise NotFound("Dataset not found.")
+
+        task = _load_owned_async_task(
+            session, tenant_id=tenant_id_str, dataset_id=dataset_id_str, task_id=str(task_id)
+        )
+        if task is None:
+            raise NotFound("Task not found.")
+        if task.status != DocumentAsyncTaskStatus.DEAD_LETTER:
+            raise DocumentAsyncTaskNotRetryableError(
+                f"Task is in {task.status} state, only dead_letter tasks can be retried."
+            )
+
+        task.status = DocumentAsyncTaskStatus.PENDING
+        task.attempt_count = 0
+        task.last_error = None
+        task.last_error_code = None
+        task.next_attempt_at = None
+        task.processing_started_at = None
+        task.completed_at = None
+        session.add(task)
+        # Commit before publishing so the worker always reads committed state,
+        # the same guarantee the create endpoint relies on.
+        session.commit()
+
+        try:
+            document_async_task.apply_async(
+                kwargs={"task_id": task.id, TASK_EXECUTION_ID_KEY: task.id},
+                queue="dataset",
+            )
+        except Exception:
+            logger.exception("Failed to re-dispatch async task %s", task.id)
+            # Roll the row forward to its terminal state; the surrounding
+            # `with_session` rollback cannot undo the commit above.
+            task.status = DocumentAsyncTaskStatus.DEAD_LETTER
+            task.last_error = "failed to re-dispatch task"
+            task.last_error_code = "retry_dispatch_failed"
+            task.completed_at = naive_utc_now()
+            session.add(task)
+            session.commit()
+            raise DocumentAsyncTaskRetryDispatchError()
+
+        return _async_task_status_response(session, task), 202

