+def _async_task_status_response(session: Session, task: DocumentAsyncTask) -> dict[str, Any]:
+    document = None
+    if task.document_id is not None:
+        document = session.scalar(select(Document).where(Document.id == task.document_id))
+    attempt_count = task.attempt_count or 0
+    return dump_response(
+        DocumentAsyncTaskStatusResponse,
+        {
+            "task_id": task.id,
+            "trace_id": task.trace_id,
+            "status": str(task.status),
+            "attempt_count": attempt_count,
+            # Derived view: attempt_count counts executions, the first of which
+            # is not a retry.
+            "retry_count": max(attempt_count - 1, 0),
+            "max_retries": MAX_RETRIES,
+            "next_attempt_at": task.next_attempt_at,
+            "last_error_code": task.last_error_code,
+            "last_error_message": task.last_error,
+            "progress": _ASYNC_TASK_PROGRESS.get(str(task.status), 0),
+            "document_id": task.document_id,
+            "document_indexing_status": str(document.indexing_status) if document is not None else None,
+            "created_at": task.created_at,
+            "completed_at": task.completed_at,
+        },
+    )
+
+
+def _load_owned_async_task(
+    session: Session, *, tenant_id: str, dataset_id: str, task_id: str
+) -> DocumentAsyncTask | None:
+    """Return the task only when it belongs to the caller's tenant and dataset."""
+    task = DocumentAsyncTaskService.get_by_id(session, task_id)
+    if task is None:
+        return None
+    if task.tenant_id != tenant_id or task.dataset_id != dataset_id:
+        return None
+    return task
