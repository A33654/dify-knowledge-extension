+# `failed` is not terminal: it means the retry budget is not exhausted yet.
+_ASYNC_TASK_PROGRESS: dict[str, int] = {
+    DocumentAsyncTaskStatus.PENDING: 0,
+    DocumentAsyncTaskStatus.PROCESSING: 50,
+    DocumentAsyncTaskStatus.FAILED: 50,
+    DocumentAsyncTaskStatus.SUCCESS: 100,
+    DocumentAsyncTaskStatus.DEAD_LETTER: 100,
+}
+
